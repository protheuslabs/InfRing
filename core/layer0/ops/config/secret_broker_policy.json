{
  "canonical_owner": "core/layer0/ops",
  "version": "1.0",
  "audit": {
    "include_backend_details": true
  },
  "rotation_policy": {
    "warn_after_days": 45,
    "max_after_days": 90,
    "require_rotated_at": false,
    "enforce_on_issue": false
  },
  "command_backend": {
    "timeout_ms": 5000
  },
  "secrets": {
    "moltbook_api_key": {
      "providers": [
        {
          "type": "env",
          "env": "MOLTBOOK_TOKEN",
          "rotated_at_env": "MOLTBOOK_TOKEN_ROTATED_AT"
        },
        {
          "type": "json_file",
          "paths": [
            "${DEFAULT_SECRETS_DIR}/moltbook.credentials.json",
            "${HOME}/.client/runtime/config/moltbook/credentials.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "command",
          "enabled": false,
          "command": [
            "bash",
            "-lc",
            "vault kv get -format=json secret/infring/moltbook_api_key"
          ],
          "parse_json": true,
          "value_path": "data.data.value",
          "rotated_at_path": "data.data.rotated_at"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "moltstack_api_key": {
      "providers": [
        {
          "type": "env",
          "env": "MOLTSTACK_TOKEN",
          "rotated_at_env": "MOLTSTACK_TOKEN_ROTATED_AT"
        },
        {
          "type": "json_file",
          "paths": [
            "${DEFAULT_SECRETS_DIR}/moltstack.credentials.json",
            "${HOME}/.client/runtime/config/moltstack/credentials.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "command",
          "enabled": false,
          "command": [
            "bash",
            "-lc",
            "aws secretsmanager get-secret-value --secret-id infring/moltstack_api_key --output json"
          ],
          "parse_json": true,
          "value_path": "SecretString",
          "rotated_at_path": "CreatedDate"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "openai_admin_key": {
      "providers": [
        {
          "type": "keychain",
          "enabled": false,
          "service": "infring.openai_admin_key",
          "account": "default",
          "rotated_at_env": "OPENAI_ADMIN_KEY_ROTATED_AT"
        },
        {
          "type": "age_file",
          "enabled": false,
          "paths": [
            "${DEFAULT_SECRETS_DIR}/openai_admin_key.age"
          ],
          "identity_paths": [
            "${DEFAULT_SECRETS_DIR}/keys/infring_secrets_age.txt"
          ],
          "parse_json": true,
          "value_path": "value",
          "rotated_at_path": "rotated_at"
        },
        {
          "type": "env",
          "env": "OPENAI_ADMIN_KEY",
          "rotated_at_env": "OPENAI_ADMIN_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "frontier_provider_admin_key": {
      "providers": [
        {
          "type": "env",
          "env": "FRONTIER_PROVIDER_ADMIN_KEY",
          "rotated_at_env": "FRONTIER_PROVIDER_ADMIN_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "xai_admin_key": {
      "providers": [
        {
          "type": "env",
          "env": "XAI_ADMIN_KEY",
          "rotated_at_env": "XAI_ADMIN_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "XAI_API_KEY",
          "rotated_at_env": "XAI_API_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "github_issue_token": {
      "providers": [
        {
          "type": "json_file",
          "paths": [
            "${DEFAULT_SECRETS_DIR}/github_issue.credentials.json"
          ],
          "field": "token",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "env",
          "env": "GITHUB_APP_INSTALLATION_TOKEN",
          "rotated_at_env": "GITHUB_APP_INSTALLATION_TOKEN_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "GITHUB_TOKEN",
          "rotated_at_env": "GITHUB_TOKEN_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "web_search_tavily_api_key": {
      "providers": [
        {
          "type": "encrypted_file",
          "paths": [
            "client/runtime/local/secrets/vault/web/search/tavily.secret.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "env",
          "env": "INFRING_TAVILY_API_KEY",
          "rotated_at_env": "INFRING_TAVILY_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "TAVILY_API_KEY",
          "rotated_at_env": "TAVILY_API_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "web_search_exa_api_key": {
      "providers": [
        {
          "type": "encrypted_file",
          "paths": [
            "client/runtime/local/secrets/vault/web/search/exa.secret.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "env",
          "env": "INFRING_EXA_API_KEY",
          "rotated_at_env": "INFRING_EXA_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "EXA_API_KEY",
          "rotated_at_env": "EXA_API_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "web_search_brave_api_key": {
      "providers": [
        {
          "type": "encrypted_file",
          "paths": [
            "client/runtime/local/secrets/vault/web/search/brave.secret.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "env",
          "env": "INFRING_BRAVE_SEARCH_API_KEY",
          "rotated_at_env": "INFRING_BRAVE_SEARCH_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "BRAVE_SEARCH_API_KEY",
          "rotated_at_env": "BRAVE_SEARCH_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "BRAVE_API_KEY",
          "rotated_at_env": "BRAVE_API_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    },
    "web_search_serperdev_api_key": {
      "providers": [
        {
          "type": "encrypted_file",
          "paths": [
            "client/runtime/local/secrets/vault/web/search/serperdev.secret.json"
          ],
          "field": "api_key",
          "rotated_at_field": "rotated_at"
        },
        {
          "type": "env",
          "env": "INFRING_SERPERDEV_API_KEY",
          "rotated_at_env": "INFRING_SERPERDEV_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "SERPERDEV_API_KEY",
          "rotated_at_env": "SERPERDEV_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "INFRING_SERPER_API_KEY",
          "rotated_at_env": "INFRING_SERPER_API_KEY_ROTATED_AT"
        },
        {
          "type": "env",
          "env": "SERPER_API_KEY",
          "rotated_at_env": "SERPER_API_KEY_ROTATED_AT"
        }
      ],
      "rotation": {
        "warn_after_days": 30,
        "max_after_days": 60,
        "require_rotated_at": false,
        "enforce_on_issue": false
      }
    }
  }
}
