{
  "name": "research_answer_synthesis",
  "workflow_type": "control_plane_orchestration_workflow",
  "workflow_role": "assistant_response_workflow",
  "default": false,
  "description": "Primitive for transforming evidence packs into answer units, bounded conclusions, and a final-answer draft.",
  "stages": [
    "evidence_pack_bind",
    "answer_unit_projection",
    "bounded_decision_projection",
    "uncertainty_calibration",
    "citation_projection",
    "draft_packaging"
  ],
  "workflow_composition": {
    "primitive_level": 0,
    "composed_of_workflow_ids": []
  },
  "final_response_policy": "control_plane_packaged_response",
  "final_output_contract": {
    "schema_version": "research_answer_synthesis_final_output_contract_v1",
    "source": "workflow_cd",
    "visible_chat_source": "llm_final_answer_only",
    "required_summary_fields": [
      "answer_units",
      "bounded_conclusion",
      "uncertainty_notes",
      "citation_projection",
      "draft_answer",
      "artifact_refs"
    ],
    "internal_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace"
    ],
    "quality_contract": {
      "answer_user_goal": "build the best direct answer the evidence supports before limitations",
      "evidence_discipline": "use evidence claims and refs as the decision basis",
      "format_freedom": "choose response structure based on the user goal rather than a hardcoded template"
    }
  },
  "research_answer_synthesis_contract": {
    "version": "research_answer_synthesis_v1",
    "required_fields": [
      "answer_units",
      "bounded_conclusion",
      "uncertainty_notes",
      "draft_answer",
      "citation_projection"
    ],
    "quality_rules": [
      "lead_with_best_supported_answer",
      "do_not_replace_answer_with_source_inventory",
      "allow_bounded_partial_answer_when_coverage_is_thin"
    ],
    "non_goals": [
      "do_not_run_new_retrieval_here",
      "do_not_use_outside_knowledge_as_decision_basis",
      "do_not_force_tables_or_lists"
    ]
  },
  "gate_contract": "control_plane_lifecycle_v1",
  "observation_lifecycle_contract": {
    "version": "run_observation_lifecycle_v1",
    "policy_ref": "orchestration/config/run_observation_lifecycle_policy.json",
    "purpose": "Record compact answer-unit synthesis events and bounded-answer choices.",
    "required_lanes": [
      "compact_ledger",
      "artifact_ref_retention",
      "failure_lifecycle_archive",
      "hot_ring_buffer"
    ],
    "non_goals": [
      "do_not_store_raw_chain_of_thought",
      "do_not_replace_final_verification",
      "do_not_emit_chat_visible_tool_trace"
    ]
  },
  "typed_execution_contract": {
    "gate_kind": "structured_control_plane_gate",
    "input_kind": "multiple_choice_or_text_input",
    "allowed_transitions": [
      "evidence_pack_bind->answer_unit_projection",
      "answer_unit_projection->bounded_decision_projection",
      "bounded_decision_projection->uncertainty_calibration",
      "uncertainty_calibration->citation_projection",
      "citation_projection->draft_packaging",
      "draft_packaging->completed",
      "evidence_pack_bind->blocked"
    ],
    "timeout_ms": 30000,
    "retry_policy": {
      "max_retries": 1,
      "on_failure": "recover_or_escalate"
    },
    "terminal_states": [
      "completed",
      "blocked",
      "needs_input",
      "failed",
      "aborted"
    ],
    "telemetry_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace",
      "final_answer"
    ],
    "tool_family_contracts": [
      "workspace",
      "web",
      "memory",
      "agent",
      "shell",
      "browser"
    ],
    "visible_chat_policy": "llm_final_only_no_system_injection",
    "run_budgets": {
      "max_stages": 8,
      "max_model_turns": 2,
      "max_tool_calls": 3,
      "token_budget": 10000,
      "loop_signature_detector": "research_answer_synthesis_v1"
    }
  },
  "workflow_source_of_truth_contract": {
    "interaction_source": "json_workflow_spec",
    "rust_reader_role": "validate_execute_trace_only",
    "hardcoded_interaction_behavior_allowed": false,
    "json_owns": [
      "interaction_gates",
      "gate_options",
      "gate_transitions",
      "tool_family_menus",
      "tool_input_schemas",
      "confirmation_states",
      "loopbacks",
      "final_output_contract"
    ],
    "rust_owns": [
      "json_loading",
      "schema_validation",
      "state_transition_execution",
      "tool_execution_handoff",
      "receipt_binding",
      "trace_export",
      "kernel_policy_enforcement"
    ]
  },
  "interaction_gate_contract": {
    "version": "llm_toolbox_gate_contract_v1",
    "tool_family_menu_stage": "gate_2_tool_family_menu",
    "tool_request_payload_stage": "gate_4_request_payload_input",
    "tool_observation_stage": "tool_observation",
    "final_answer_stage": "gate_6_llm_final_output",
    "recovery_stage": "draft_packaging",
    "gates": [
      {
        "stage": "gate_1_need_tool_access_menu",
        "parser_kind": "need_tools",
        "true_values": ["yes", "y", "true", "t", "1"],
        "false_values": ["no", "n", "false", "f", "0"]
      },
      {
        "stage": "gate_2_tool_family_menu",
        "parser_kind": "tool_family",
        "choice_base": 1
      },
      {
        "stage": "gate_3_tool_menu",
        "parser_kind": "tool_name"
      },
      {
        "stage": "gate_4_request_payload_input",
        "parser_kind": "request_payload"
      },
      {
        "stage": "gate_5_post_tool_menu",
        "parser_kind": "post_tool",
        "finish_values": ["finish", "done", "submit"],
        "another_tool_values": ["another", "another tool", "use another tool"]
      }
    ]
  },
  "workflow_composition_contract": {
    "version": "workflow_composition_contract_v1",
    "cd_kind": "primitive",
    "returns_exactly_one_terminal_artifact": true,
    "terminal_artifact_contract": {
      "artifact_schema": "workflow_terminal_artifact_v1",
      "allowed_kinds": [
        "completed_final_answer",
        "clarification_request",
        "structured_failure",
        "delegated_workflow_result"
      ],
      "parent_receives": "terminal_artifact_only_refs_for_internals"
    },
    "child_workflow_calls": [],
    "non_goals": [
      "do_not_rerun_retrieval_here",
      "do_not_force_specific_output_format",
      "do_not_answer_from_memory_when_evidence_is_missing"
    ]
  }
}
