{
  "name": "local_project_bootstrap",
  "workflow_type": "control_plane_orchestration_workflow",
  "workflow_role": "assistant_response_workflow",
  "default": false,
  "description": "Primitive contract for deciding and collecting the minimum local project context needed before a coding mutation.",
  "primitive_first_contract": {
    "case_specific_hardcoding_allowed": false,
    "specificity_owner": "primitive",
    "extension_surface": "workflow_cd",
    "registered_capability_id": "workflow.local_project_bootstrap",
    "special_case_policy": "Bootstrap behavior may vary by generic project shape, task scope, and explicit context; it must not branch on eval levels, fixture filenames, or benchmark task names.",
    "monotonic_lower_level_regression_policy": "The primitive must preserve context-free fast paths while adding bounded discovery only when local project context is required."
  },
  "provenance_contract": {
    "source_systems": [
      "Aider",
      "Codex",
      "Claude Code",
      "ForgeCode"
    ],
    "import_rule": "assimilate_minimal_context_bootstrap_patterns_not_tool_branding",
    "artifact_corpus_ref": "references/coding-agent-systems"
  },
  "stages": [
    "task_scope_intake",
    "context_need_decision",
    "bounded_project_discovery",
    "selective_file_read",
    "context_artifact_packaging"
  ],
  "workflow_composition": {
    "primitive_level": 0,
    "composed_of_workflow_ids": []
  },
  "final_response_policy": "control_plane_packaged_response",
  "final_output_contract": {
    "schema_version": "local_project_bootstrap_final_output_contract_v1",
    "source": "workflow_cd",
    "visible_chat_source": "llm_final_answer_only",
    "required_summary_fields": [
      "status",
      "context_mode",
      "read_scope",
      "files_considered",
      "files_read",
      "confidence",
      "gaps",
      "error"
    ],
    "internal_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace"
    ],
    "quality_contract": {
      "answer_user_goal": "produce the smallest useful project context artifact for the next coding stage",
      "scope_boundary": "do not mutate files, validate software, write memory, or decide final task success",
      "validation_calibration": "successful context collection means the next stage has bounded context, not that implementation is correct",
      "visibility": "return compact context summary fields and safe tool receipt refs"
    }
  },
  "local_project_bootstrap_contract": {
    "version": "local_project_bootstrap_v1",
    "input_contract": {
      "schema": "local_project_bootstrap_input_v1",
      "required_fields": [
        "task_intent",
        "cwd"
      ],
      "optional_fields": [
        "explicit_target_paths",
        "known_write_scope",
        "project_context_hint",
        "existing_project_flag",
        "max_files",
        "max_bytes"
      ],
      "allowed_context_modes": [
        "context_free_greenfield",
        "known_file_focus",
        "bounded_existing_project_discovery"
      ]
    },
    "required_behaviors": [
      "classify_whether_local_context_is_needed_before_reading",
      "skip_broad_discovery_for_context_free_greenfield_tasks",
      "prefer_explicit_target_paths_when_available",
      "use_bounded_file_listing_and_stat_before_file_reads_for_existing_projects",
      "cap_file_count_and_byte_count_for_reads",
      "emit_context_confidence_and_gaps",
      "treat_collected_context_as_current_file_evidence_not_project_memory"
    ],
    "output_receipts": [
      "local_project_context_receipt_v1"
    ],
    "failure_modes": [
      "cwd_unavailable",
      "read_scope_out_of_bounds",
      "required_target_missing",
      "context_budget_exhausted",
      "permission_denied",
      "io_error"
    ],
    "native_tool_mapping": {
      "discover": [
        "file_list",
        "file_stat"
      ],
      "read": [
        "file_read",
        "file_read_many"
      ]
    },
    "non_goals": [
      "do_not_write_or_patch_files",
      "do_not_run_validation_commands",
      "do_not_generate_architecture",
      "do_not_retrieve_checkpoint_memory",
      "do_not_branch_on_eval_level_or_fixture_name"
    ]
  },
  "gate_contract": "control_plane_lifecycle_v1",
  "typed_execution_contract": {
    "gate_kind": "structured_control_plane_gate",
    "input_kind": "multiple_choice_or_text_input",
    "allowed_transitions": [
      "task_scope_intake->context_need_decision",
      "context_need_decision->bounded_project_discovery",
      "context_need_decision->context_artifact_packaging",
      "bounded_project_discovery->selective_file_read",
      "selective_file_read->context_artifact_packaging",
      "context_artifact_packaging->completed",
      "context_need_decision->needs_input",
      "bounded_project_discovery->blocked",
      "selective_file_read->failed"
    ],
    "timeout_ms": 30000,
    "retry_policy": {
      "max_retries": 0,
      "on_failure": "return_structured_failure"
    },
    "terminal_states": [
      "completed",
      "blocked",
      "failed",
      "needs_input",
      "aborted"
    ],
    "telemetry_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace",
      "final_answer"
    ],
    "tool_family_contracts": [
      "workspace",
      "web",
      "memory",
      "agent",
      "shell",
      "browser"
    ],
    "visible_chat_policy": "llm_final_only_no_system_injection",
    "run_budgets": {
      "max_stages": 5,
      "max_model_turns": 1,
      "max_tool_calls": 4,
      "token_budget": 4000,
      "loop_signature_detector": "local_project_bootstrap_v1"
    }
  },
  "workflow_source_of_truth_contract": {
    "interaction_source": "json_workflow_spec",
    "rust_reader_role": "validate_execute_trace_only",
    "hardcoded_interaction_behavior_allowed": false,
    "json_owns": [
      "interaction_gates",
      "gate_options",
      "gate_transitions",
      "tool_family_menus",
      "tool_input_schemas",
      "confirmation_states",
      "loopbacks",
      "final_output_contract"
    ],
    "rust_owns": [
      "json_loading",
      "schema_validation",
      "state_transition_execution",
      "tool_execution_handoff",
      "receipt_binding",
      "trace_export",
      "kernel_policy_enforcement"
    ]
  },
  "observation_lifecycle_contract": {
    "version": "run_observation_lifecycle_v1",
    "policy_ref": "orchestration/config/run_observation_lifecycle_policy.json",
    "purpose": "Emit compact workflow observations for context need decisions, bounded file discovery, selective reads, and terminal outcomes; keep raw file payloads out of lifecycle storage.",
    "required_lanes": [
      "compact_ledger",
      "hot_ring_buffer",
      "failure_lifecycle_archive",
      "artifact_ref_retention"
    ],
    "non_goals": [
      "do_not_hide_current_failures",
      "do_not_store_raw_tool_payloads",
      "do_not_force_response_formats"
    ]
  },
  "interaction_gate_contract": {
    "version": "llm_toolbox_gate_contract_v1",
    "tool_family_menu_stage": "gate_2_tool_family_menu",
    "tool_request_payload_stage": "gate_4_request_payload_input",
    "tool_observation_stage": "tool_observation",
    "final_answer_stage": "gate_6_llm_final_output",
    "recovery_stage": "recovery_escalation",
    "gates": [
      {
        "stage": "gate_1_need_tool_access_menu",
        "parser_kind": "need_tools",
        "choice_base": 0,
        "true_values": [
          "yes",
          "y",
          "true",
          "t",
          "1"
        ],
        "false_values": [
          "no",
          "n",
          "false",
          "f",
          "0"
        ],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_2_tool_family_menu",
        "parser_kind": "tool_family",
        "choice_base": 1,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_3_tool_menu",
        "parser_kind": "tool_name",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_4_request_payload_input",
        "parser_kind": "request_payload",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_5_post_tool_menu",
        "parser_kind": "post_tool",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [
          "finish",
          "done",
          "submit"
        ],
        "another_tool_values": [
          "another",
          "another tool",
          "use another tool"
        ]
      }
    ]
  },
  "workflow_composition_contract": {
    "version": "workflow_composition_contract_v1",
    "cd_kind": "primitive",
    "returns_exactly_one_terminal_artifact": true,
    "terminal_artifact_contract": {
      "artifact_schema": "workflow_terminal_artifact_v1",
      "allowed_kinds": [
        "completed_final_answer",
        "clarification_request",
        "structured_failure",
        "delegated_workflow_result"
      ],
      "parent_receives": "terminal_artifact_only_refs_for_internals"
    },
    "child_workflow_calls": [],
    "non_goals": [
      "do_not_call_child_workflows",
      "do_not_return_raw_tool_payloads",
      "do_not_expose_internal_trace",
      "do_not_decide_task_success"
    ]
  }
}
