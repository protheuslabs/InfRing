{
  "name": "checkpoint_memory_bootstrap",
  "workflow_type": "control_plane_orchestration_workflow",
  "workflow_role": "assistant_response_workflow",
  "default": false,
  "description": "Primitive contract for retrieving bounded checkpoint memory as advisory context before continuing a coding task.",
  "primitive_first_contract": {
    "case_specific_hardcoding_allowed": false,
    "specificity_owner": "primitive",
    "extension_surface": "workflow_cd",
    "registered_capability_id": "workflow.checkpoint_memory_bootstrap",
    "special_case_policy": "Memory lookup behavior may vary by generic checkpoint key, project fingerprint, and freshness policy; it must not branch on eval levels, fixture filenames, or benchmark task names.",
    "monotonic_lower_level_regression_policy": "The primitive must never make memory lookup mandatory for context-free or first-run tasks."
  },
  "provenance_contract": {
    "source_systems": [
      "Codex",
      "ForgeCode",
      "OpenHands"
    ],
    "import_rule": "assimilate_resume_context_and_checkpoint_boundary_patterns_not_storage_branding",
    "artifact_corpus_ref": "references/coding-agent-systems"
  },
  "stages": [
    "checkpoint_need_intake",
    "project_fingerprint_projection",
    "bounded_memory_lookup",
    "freshness_and_relevance_filter",
    "memory_artifact_packaging"
  ],
  "workflow_composition": {
    "primitive_level": 0,
    "composed_of_workflow_ids": []
  },
  "final_response_policy": "control_plane_packaged_response",
  "final_output_contract": {
    "schema_version": "checkpoint_memory_bootstrap_final_output_contract_v1",
    "source": "workflow_cd",
    "visible_chat_source": "llm_final_answer_only",
    "required_summary_fields": [
      "status",
      "lookup_key",
      "project_fingerprint",
      "memory_rows_considered",
      "memory_rows_selected",
      "freshness",
      "confidence",
      "gaps",
      "error"
    ],
    "internal_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace"
    ],
    "quality_contract": {
      "answer_user_goal": "produce bounded advisory memory context for the next coding stage",
      "scope_boundary": "do not mutate files, validate software, discover project files, or treat memory as authoritative over current files",
      "validation_calibration": "successful memory retrieval means relevant history was found or safely absent, not that the current project state is known",
      "visibility": "return compact memory summary fields and safe receipt refs"
    }
  },
  "checkpoint_memory_bootstrap_contract": {
    "version": "checkpoint_memory_bootstrap_v1",
    "input_contract": {
      "schema": "checkpoint_memory_bootstrap_input_v1",
      "required_fields": [
        "task_intent",
        "cwd"
      ],
      "optional_fields": [
        "checkpoint_id",
        "resume_token",
        "project_fingerprint",
        "local_project_bootstrap_artifact_ref",
        "max_rows",
        "freshness_policy"
      ],
      "allowed_lookup_modes": [
        "skip_when_no_checkpoint_signal",
        "checkpoint_id_lookup",
        "project_fingerprint_lookup",
        "resume_token_lookup"
      ]
    },
    "required_behaviors": [
      "skip_lookup_when_task_has_no_checkpoint_or_resume_signal",
      "prefer_explicit_checkpoint_id_or_resume_token_when_available",
      "use_project_fingerprint_as_secondary_lookup_key",
      "cap_memory_rows_and_payload_size",
      "downgrade_stale_or_low_relevance_memory_to_hints",
      "emit_no_memory_found_as_non_blocking_artifact",
      "never_override_current_file_context_with_memory"
    ],
    "output_receipts": [
      "checkpoint_memory_context_receipt_v1"
    ],
    "failure_modes": [
      "memory_provider_unavailable",
      "lookup_key_ambiguous",
      "memory_payload_budget_exhausted",
      "permission_denied",
      "storage_error"
    ],
    "native_tool_mapping": {
      "lookup": [
        "memory_search",
        "memory_read"
      ]
    },
    "non_goals": [
      "do_not_write_or_patch_files",
      "do_not_write_checkpoint_memory",
      "do_not_run_validation_commands",
      "do_not_discover_project_files",
      "do_not_branch_on_eval_level_or_fixture_name"
    ]
  },
  "gate_contract": "control_plane_lifecycle_v1",
  "typed_execution_contract": {
    "gate_kind": "structured_control_plane_gate",
    "input_kind": "multiple_choice_or_text_input",
    "allowed_transitions": [
      "checkpoint_need_intake->project_fingerprint_projection",
      "checkpoint_need_intake->memory_artifact_packaging",
      "project_fingerprint_projection->bounded_memory_lookup",
      "bounded_memory_lookup->freshness_and_relevance_filter",
      "freshness_and_relevance_filter->memory_artifact_packaging",
      "memory_artifact_packaging->completed",
      "checkpoint_need_intake->needs_input",
      "bounded_memory_lookup->failed",
      "freshness_and_relevance_filter->blocked"
    ],
    "timeout_ms": 30000,
    "retry_policy": {
      "max_retries": 0,
      "on_failure": "return_structured_failure"
    },
    "terminal_states": [
      "completed",
      "blocked",
      "failed",
      "needs_input",
      "aborted"
    ],
    "telemetry_streams": [
      "workflow_state",
      "agent_internal_notes",
      "tool_trace",
      "eval_trace",
      "final_answer"
    ],
    "tool_family_contracts": [
      "workspace",
      "web",
      "memory"
      ,
      "agent",
      "shell",
      "browser"
    ],
    "visible_chat_policy": "llm_final_only_no_system_injection",
    "run_budgets": {
      "max_stages": 5,
      "max_model_turns": 1,
      "max_tool_calls": 2,
      "token_budget": 3000,
      "loop_signature_detector": "checkpoint_memory_bootstrap_v1"
    }
  },
  "workflow_source_of_truth_contract": {
    "interaction_source": "json_workflow_spec",
    "rust_reader_role": "validate_execute_trace_only",
    "hardcoded_interaction_behavior_allowed": false,
    "json_owns": [
      "interaction_gates",
      "gate_options",
      "gate_transitions",
      "tool_family_menus",
      "tool_input_schemas",
      "confirmation_states",
      "loopbacks",
      "final_output_contract"
    ],
    "rust_owns": [
      "json_loading",
      "schema_validation",
      "state_transition_execution",
      "tool_execution_handoff",
      "receipt_binding",
      "trace_export",
      "kernel_policy_enforcement"
    ]
  },
  "observation_lifecycle_contract": {
    "version": "run_observation_lifecycle_v1",
    "policy_ref": "orchestration/config/run_observation_lifecycle_policy.json",
    "purpose": "Emit compact workflow observations for checkpoint need decisions, bounded memory lookup, freshness filtering, and terminal outcomes; keep raw memory payloads out of lifecycle storage.",
    "required_lanes": [
      "compact_ledger",
      "hot_ring_buffer",
      "failure_lifecycle_archive",
      "artifact_ref_retention"
    ],
    "non_goals": [
      "do_not_hide_current_failures",
      "do_not_store_raw_tool_payloads",
      "do_not_force_response_formats"
    ]
  },
  "interaction_gate_contract": {
    "version": "llm_toolbox_gate_contract_v1",
    "tool_family_menu_stage": "gate_2_tool_family_menu",
    "tool_request_payload_stage": "gate_4_request_payload_input",
    "tool_observation_stage": "tool_observation",
    "final_answer_stage": "gate_6_llm_final_output",
    "recovery_stage": "recovery_escalation",
    "gates": [
      {
        "stage": "gate_1_need_tool_access_menu",
        "parser_kind": "need_tools",
        "choice_base": 0,
        "true_values": [
          "yes",
          "y",
          "true",
          "t",
          "1"
        ],
        "false_values": [
          "no",
          "n",
          "false",
          "f",
          "0"
        ],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_2_tool_family_menu",
        "parser_kind": "tool_family",
        "choice_base": 1,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_3_tool_menu",
        "parser_kind": "tool_name",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_4_request_payload_input",
        "parser_kind": "request_payload",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [],
        "another_tool_values": []
      },
      {
        "stage": "gate_5_post_tool_menu",
        "parser_kind": "post_tool",
        "choice_base": 0,
        "true_values": [],
        "false_values": [],
        "finish_values": [
          "finish",
          "done",
          "submit"
        ],
        "another_tool_values": [
          "another",
          "another tool",
          "use another tool"
        ]
      }
    ]
  },
  "workflow_composition_contract": {
    "version": "workflow_composition_contract_v1",
    "cd_kind": "primitive",
    "returns_exactly_one_terminal_artifact": true,
    "terminal_artifact_contract": {
      "artifact_schema": "workflow_terminal_artifact_v1",
      "allowed_kinds": [
        "completed_final_answer",
        "clarification_request",
        "structured_failure",
        "delegated_workflow_result"
      ],
      "parent_receives": "terminal_artifact_only_refs_for_internals"
    },
    "child_workflow_calls": [],
    "non_goals": [
      "do_not_call_child_workflows",
      "do_not_return_raw_tool_payloads",
      "do_not_expose_internal_trace",
      "do_not_decide_task_success"
    ]
  }
}
