{
  "canonical_path": "core/layer0/ops/config/web_conduit_policy.json",
  "canonical_owner": "core/layer0/ops",
  "compatibility_mirror": true,
  "mode": "production",
  "version": "v1",
  "web_conduit": {
    "allow_domains": [],
    "deny_domains": [
      "127.0.0.1",
      "localhost",
      "metadata.google.internal",
      "169.254.169.254"
    ],
    "enabled": true,
    "max_response_bytes": 350000,
    "rate_limit_per_minute": 30,
    "require_human_for_sensitive": true,
    "search_default_count": 16,
    "search_max_count": 40,
    "search_cache_ttl_minutes": 8,
    "search_provider_config": {
      "tavily": {
        "secret_id": "web_search_tavily_api_key",
        "api_key_env": "TAVILY_API_KEY"
      },
      "exa": {
        "secret_id": "web_search_exa_api_key",
        "api_key_env": "EXA_API_KEY"
      },
      "brave": {
        "secret_id": "web_search_brave_api_key",
        "api_key_env": "BRAVE_SEARCH_API_KEY"
      },
      "serperdev": {
        "secret_id": "web_search_serperdev_api_key",
        "api_key_env": "SERPER_API_KEY"
      }
    },
    "search_provider_order": [
      "tavily",
      "exa",
      "brave",
      "serperdev",
      "google_news_rss",
      "bing_rss",
      "duckduckgo_lite",
      "duckduckgo"
    ],
    "fetch_provider_order": [
      "direct_http"
    ],
    "native_codex_web_search": {
      "enabled": false,
      "mode": "cached",
      "allowed_domains": []
    },
    "provider_circuit_breaker": {
      "enabled": true,
      "failure_threshold": 3,
      "open_for_secs": 300,
      "soft_failure_errors": [
        "low_signal_search_payload",
        "no_usable_summary",
        "query_result_mismatch"
      ]
    },
    "sensitive_domains": [
      "accounts.google.com",
      "api.stripe.com",
      "paypal.com",
      "chase.com",
      "bankofamerica.com"
    ],
    "timeout_ms": 12000
  }
}
