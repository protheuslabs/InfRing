{
  "type": "repo_entropy_scorecard_policy",
  "schema_version": 3,
  "owner_domain": "validation.scorecards",
  "report_path": "core/local/artifacts/repo_entropy_scorecard_current.json",
  "markdown_report_path": "local/workspace/reports/REPO_ENTROPY_SCORECARD_CURRENT.md",
  "history_path": "local/state/validation/repo_entropy_scorecard/history.jsonl",
  "purpose": "Track whether repo growth is making InfRing harder to operate, reason about, or safely release.",
  "required_dimensions": [
    "worktree_churn",
    "command_surface",
    "ci_surface",
    "artifact_pressure",
    "loc_growth",
    "guard_surface",
    "duplicate_surfaces",
    "generated_artifact_residue",
    "installer_monolith",
    "test_lifecycle_debt",
    "real_work_gap"
  ],
  "tracked_metrics": [
    "dirty_paths",
    "dirty_added",
    "dirty_modified",
    "dirty_deleted",
    "dirty_untracked",
    "npm_scripts",
    "command_entries",
    "compat_command_entries",
    "operator_surface_entries",
    "workflow_files",
    "required_ci_checks",
    "core_local_artifacts",
    "core_local_artifact_bytes",
    "artifact_cleanup_candidates",
    "effective_loc",
    "effective_loc_delta_pct",
    "guard_scripts",
    "gate_registry_entries",
    "duplicate_surface_roots",
    "tracked_generated_artifacts",
    "installer_monolith_bytes",
    "test_scaffold_debt",
    "test_lifecycle_overdue",
    "real_work_missing_ready_lanes",
    "real_work_missing_user_visible_lanes"
  ],
  "thresholds": {
    "red": {
      "dirty_paths": 250,
      "command_entries": 1200,
      "npm_scripts": 1000,
      "required_ci_checks": 35,
      "workflow_files": 65,
      "core_local_artifacts": 800,
      "core_local_artifact_bytes": 524288000,
      "effective_loc_delta_pct": 10,
      "guard_scripts": 240,
      "gate_registry_entries": 220,
      "duplicate_surface_roots": 2,
      "tracked_generated_artifacts": 650,
      "installer_monolith_bytes": 524288,
      "test_scaffold_debt": 60,
      "test_lifecycle_overdue": 25,
      "real_work_missing_ready_lanes": 4,
      "real_work_missing_user_visible_lanes": 3
    },
    "yellow": {
      "dirty_paths": 50,
      "command_entries": 900,
      "npm_scripts": 700,
      "required_ci_checks": 25,
      "workflow_files": 45,
      "core_local_artifacts": 400,
      "core_local_artifact_bytes": 209715200,
      "effective_loc_delta_pct": 3,
      "guard_scripts": 160,
      "gate_registry_entries": 150,
      "duplicate_surface_roots": 1,
      "tracked_generated_artifacts": 250,
      "installer_monolith_bytes": 262144,
      "test_scaffold_debt": 25,
      "test_lifecycle_overdue": 5,
      "real_work_missing_ready_lanes": 1,
      "real_work_missing_user_visible_lanes": 1
    }
  },
  "generated_artifact_patterns": [
    "000-combined.rs",
    ".combined_parts/",
    ".combined_parts",
    "_parts/000-combined.rs",
    "combined_parts/"
  ],
  "installer_monolith_files": [
    "install.sh",
    "install.ps1"
  ],
  "test_lifecycle_debt_classifications": [
    "temporary_scaffold",
    "temporary_monitor",
    "runtime_crutch",
    "one_time_closure_guard"
  ],
  "duplicate_surface_pairs": [
    {
      "id": "orchestration_root_transition",
      "roots": [
        "orchestration",
        "surface/orchestration"
      ],
      "owner": "architecture_governance",
      "next_action": "Declare one root canonical and give the compatibility root an expiry."
    },
    {
      "id": "shell_root_transition",
      "roots": [
        "shell",
        "client"
      ],
      "owner": "shell_governance",
      "next_action": "Keep legacy shell isolated while new shell/gateway projections become canonical."
    }
  ],
  "artifact_roots": [
    "core/local/artifacts"
  ],
  "workflow_root": ".github/workflows",
  "guard_roots": [
    "tests/tooling/scripts/ci"
  ],
  "source_artifacts": {
    "effective_loc": "core/local/artifacts/effective_loc_metric_current.json",
    "churn_guard": "core/local/artifacts/churn_guard_current.json",
    "guard_registry_ownership": "core/local/artifacts/guard_registry_ownership_current.json",
    "ci_required_gate_reduction_plan": "validation/reports/ci_required_gate_reduction_plan_2026-05-10.json",
    "ci_workflow_tier_manifest": "validation/conformance/contracts/ci_workflow_tier_manifest.json",
    "command_registry": "tools/commands/command_registry.json",
    "tooling_gate_registry": "tests/tooling/config/tooling_gate_registry.json",
    "artifact_retention": "core/local/artifacts/assurance_artifact_retention_report_current.json",
    "test_lifecycle_registry": "validation/tests/contracts/validation_test_lifecycle_registry.json",
    "real_work_workflow_proof": "core/local/artifacts/real_work_workflow_proof_current.json"
  },
  "policy": {
    "scorecard_is_observational_by_default": true,
    "strict_guard_checks_schema_not_thresholds": true,
    "red_dimensions_require_next_actions": true,
    "scorecard_must_not_mutate_worktree": true,
    "scorecard_must_not_read_shell_or_orchestration_internals": true,
    "loc_growth_uses_existing_effective_loc_artifact_when_available": true,
    "history_deltas_required": true,
    "top_entropy_drivers_required": true,
    "artifact_pressure_must_include_retention_candidates": true,
    "dirty_churn_must_include_status_breakdown": true,
    "blob_pressure_must_cover_generated_installer_tests_and_real_work": true
  }
}
