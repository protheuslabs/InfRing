{
  "type": "agent_runtime_framework_capability_catalog",
  "version": 1,
  "owner": "validation.agent_runtime",
  "transport_contract": "gateway.agent_runtime_socket",
  "capability_taxonomy": [
    "conversation_context",
    "multi_turn_continuity",
    "working_directory_control",
    "file_read",
    "file_write",
    "shell_command",
    "patch_apply",
    "approval_pause_resume",
    "permission_request",
    "activity_dialog_stream",
    "decision_dialog",
    "tool_trace_visibility",
    "artifact_receipt",
    "large_paste_attachment",
    "context_budgeting",
    "model_selection",
    "provider_identity",
    "provider_auth_discovery",
    "failure_reporting",
    "hard_failure_chat_injection"
  ],
  "shared_socket_expectations": [
    "All frameworks enter InfRing through one Agent Runtime socket shape.",
    "Private native schemas are translated by adapters before reaching Gateway projections.",
    "Durable writes become proposals or receipts.",
    "The selected working directory is explicit and never inferred from Shell state.",
    "Activity and decision-dialog output is preserved as runtime activity projection rows.",
    "Missing auth, quota exhaustion, missing binaries, and unavailable providers become explicit diagnostics."
  ],
  "frameworks": [
    {
      "id": "infring_native",
      "display_name": "InfRing Native",
      "kind": "native_engine",
      "socket_engine_id": "infring_native",
      "availability_probe": {
        "type": "gateway_provider_registry",
        "endpoint": "/api/shell-socket/agent-runtime/providers"
      },
      "native_invocation": {
        "supported": false,
        "reason": "InfRing Native is measured through the InfRing socket path."
      },
      "native_features": {
        "conversation_context": true,
        "multi_turn_continuity": true,
        "working_directory_control": true,
        "file_read": true,
        "file_write": "approval_required",
        "shell_command": "approval_required",
        "approval_pause_resume": true,
        "activity_dialog_stream": true,
        "decision_dialog": true,
        "model_selection": true,
        "failure_reporting": true
      },
      "socket_features_expected": [
        "conversation_context",
        "multi_turn_continuity",
        "working_directory_control",
        "file_read",
        "file_write",
        "shell_command",
        "approval_pause_resume",
        "activity_dialog_stream",
        "decision_dialog",
        "model_selection",
        "failure_reporting"
