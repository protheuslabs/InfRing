    "hard_failure_chat_injection"
  ],
  "shared_socket_expectations": [
    "All frameworks enter InfRing through one Agent Runtime socket shape.",
    "Private native schemas are translated by adapters before reaching Gateway projections.",
    "Durable writes become proposals or receipts.",
    "The selected working directory is explicit and never inferred from Shell state.",
    "Activity and decision-dialog output is preserved as runtime activity projection rows.",
    "Missing auth, quota exhaustion, missing binaries, and unavailable providers become explicit diagnostics."
  ],
