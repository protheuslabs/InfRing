{
  "type": "agent_runtime_socket_contract",
  "schema_version": 1,
  "version": "2026-06-03",
  "owner": "assurance.validation",
  "status": "contracted",
  "srs_refs": [
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-001",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-004",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-005",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-006",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-007",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-008",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-009",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-010",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-011",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-012",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-013",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-014",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-020"
  ],
  "policy_refs": [
    "docs/workspace/SRS.md",
    "docs/workspace/gateway_ingress_egress_policy.md",
    "docs/workspace/interface_payload_budget_policy.md",
    "docs/workspace/universal_trace_substrate_policy.md",
    "docs/workspace/shell_ui_projection_policy.md",
    "docs/workspace/nexus_conduit_checkpoint_policy.md"
  ],
  "turn_outcome_contract": "validation/conformance/contracts/agent_runtime_turn_outcome_contract.json",
  "router_scope_contract": "validation/conformance/contracts/agent_runtime_router_scope_contract.json",
  "canonical_endpoint": {
    "route_id": "agent_runtime.socket",
    "transport": "websocket",
    "canonical_route_pattern": "/ws/agent-runtime",
    "route_class": "request_ingress_and_event_output_egress",
    "owner_of_boundary": "gateway",
    "source_domain": "shell_or_external_client_projection",
    "target_domain": "gateway.agent_runtime_router",
    "implementation_status": "live"
  },
  "gateway_only_invariant": {
    "shell_to_gateway_only": true,
    "no_shell_to_adapter_direct_socket": true,
    "no_shell_to_engine_direct_socket": true,
    "no_shell_to_orchestration_direct_agent_turn": true,
    "no_shell_to_kernel_direct_agent_turn": true,
    "external_engines_enter_gateway_only": true,
    "gateway_remains_external_ambiguity_firewall": true,
    "dashboard_is_shell_not_gateway_host": true,
    "gateway_physical_domain": "gateway/**",
    "adapters_are_translator_only": true
  },
  "trace_identity_rule": {
    "trace_id_required_on_every_message": true,
    "trace_id_minted_at_initial_user_request": true,
    "engines_may_create_span_id": true,
    "engines_may_not_remint_trace_id": true,
    "engines_may_not_drop_trace_id": true,
    "engines_may_not_replace_trace_id": true,
    "gateway_router_rejects_adapter_trace_id_replacement": true
  },
  "required_client_to_gateway_events": [
    {
      "type": "engine.list",
      "required_fields": [
        "type",
        "trace_id",
        "request_id"
      ],
      "purpose": "Discover selectable agent runtime engines through Gateway."
    },
    {
      "type": "engine.health",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id"
      ],
      "purpose": "Request bounded health for a selected engine."
    },
    {
      "type": "session.start",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id",
        "session_id",
        "scope"
      ],
      "purpose": "Create or attach a runtime session under a selected engine."
    },
    {
      "type": "turn.submit",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id",
        "session_id",
        "input",
        "scope",
        "capability_budget"
      ],
      "purpose": "Submit a user turn to the selected runtime engine.",
      "optional_fields": [
        "context_pack",
        "universal_tool_proposals",
        "model_provider_context"
      ],
      "payload_rules": [
        "context_pack must follow validation/conformance/contracts/agent_runtime_context_pack_contract.json when present",
        "context_pack is continuity context, not execution authority",
        "raw conversation history is prohibited; use bounded fragments and refs",
        "context_pack may include universal_tool_grants from validation/conformance/contracts/agent_runtime_universal_tools_contract.json",
        "engines may propose universal tool calls only through Gateway-normalized proposal events",
        "engines may not execute universal tools directly or claim durable effects without receipt refs"
      ]
    },
    {
      "type": "turn.cancel",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id",
        "session_id",
        "turn_id"
      ],
      "purpose": "Cancel a live turn through Gateway-owned admission."
    }
  ],
  "required_gateway_to_client_events": [
    {
      "type": "engine.list.result",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engines"
      ],
      "payload_rules": [
        "engine rows are bounded projections",
        "engine rows may include available_models as the canonical Gateway-owned model availability projection",
        "available_models rows must represent real model identifiers; default/framework-default is a selection policy, not a model row",
        "Gateway must prefer runtime/provider model discovery over registry seed rows when a trusted discovery command or API is available",
        "catalog_refresh_policy must disclose whether rows came from runtime_discovered or registry_static_seed authority",
        "legacy model_menu fields are compatibility aliases only",
        "no adapter internals"
      ]
    },
    {
      "type": "engine.health.result",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id",
        "status"
      ],
      "payload_rules": [
        "health is a projection",
        "no raw process dumps"
      ]
    },
    {
      "type": "session.started",
      "required_fields": [
        "type",
        "trace_id",
        "request_id",
        "engine_id",
        "session_id",
        "receipt_ref"
      ],
      "payload_rules": [
        "receipt_ref required",
        "no raw orchestration or external framework state"
      ]
    },
    {
      "type": "assistant.delta",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "delta"
      ],
      "payload_rules": [
        "delta is display-bounded",
        "large content moves behind detail_ref"
      ]
    },
    {
      "type": "tool.proposed",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "tool_call_ref",
        "capability"
      ],
      "payload_rules": [
        "tool inputs are redacted projections",
        "raw tool input requires detail route and policy",
        "universal tool proposals must match validation/conformance/contracts/agent_runtime_universal_tools_contract.json",
        "proposal-only universal tools require Gateway validation before execution",
        "native workflow tools are not exposed as universal tools"
      ]
    },
    {
      "type": "permission.requested",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "approval_id",
        "tool_call_ref",
        "tool_id",
        "capability",
        "gatekeeper_kind"
      ],
      "payload_rules": [
        "permission requests are bounded projections attached to tool proposals",
        "default-allowed read tools skip this event unless revoked by permission policy",
        "mutating/proposal tools require allow_once, deny, or always_allow_tool_call",
        "gatekeeper_kind defaults to user but may graduate to system_policy or agent_supervisor"
      ]
    },
    {
      "type": "tool.started",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "tool_call_ref",
        "receipt_ref"
      ],
      "payload_rules": [
        "receipt_ref required"
      ]
    },
    {
      "type": "tool.completed",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "tool_call_ref",
        "status",
        "result_ref",
        "receipt_ref"
      ],
      "payload_rules": [
        "result_ref required for non-trivial outputs",
        "no raw tool result in default event"
      ]
    },
    {
      "type": "artifact.created",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "artifact_ref",
        "artifact_kind"
      ],
      "payload_rules": [
        "artifact body by ref only"
      ]
    },
    {
      "type": "receipt.created",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "receipt_ref",
        "receipt_kind"
      ],
      "payload_rules": [
        "receipt body by ref unless explicitly budgeted"
      ]
    },
    {
      "type": "error",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "error_code",
        "retryable"
      ],
      "payload_rules": [
        "error text bounded",
        "stack traces by ref only"
      ]
    },
    {
      "type": "heartbeat",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "status"
      ],
      "payload_rules": [
        "heartbeat must be compact and periodicity-bounded"
      ]
    },
    {
      "type": "turn.complete",
      "required_fields": [
        "type",
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "status",
        "result_ref",
        "receipt_ref"
      ],
      "payload_rules": [
        "final result is a projection plus refs",
        "raw framework transcript prohibited by default"
      ]
    }
  ],
  "context_pack_contract": "validation/conformance/contracts/agent_runtime_context_pack_contract.json",
  "forbidden_default_payload_fields": [
    "raw",
    "root",
    "all_messages",
    "conversation_tree",
    "raw_tool_input",
    "raw_tool_result",
    "trace_body",
    "plan_graph",
    "workflow_graph",
    "execution_observation",
    "authorization_state",
    "policy_decision",
    "external_framework_transcript",
    "adapter_process_dump"
  ],
  "required_gateway_enforcement": [
    "authentication",
    "authorization",
    "payload_limits",
    "ingress_normalization",
    "engine_registry_lookup",
    "capability_budget_checks",
    "workspace_scope_checks",
    "mutation_approval_checks",
    "runtime_neutral_permission_gate",
    "rate_limits",
    "timeouts",
    "cancellation",
    "audit_receipts",
    "trace_propagation",
    "lazy_detail_access",
    "engine_quarantine"
  ],
  "kernel_authority_invariant": {
    "engines_produce_intentions_not_authority": true,
    "durable_effects_require_kernel_or_gateway_policy": true,
    "engine_adapters_cannot_write_canonical_memory_directly": true,
    "engine_adapters_cannot_bypass_capability_checks": true,
    "receipts_record_engine_id_and_trace_id": true
  },
  "payload_budget_policy": {
    "inherits": "validation/conformance/contracts/interface_payload_budget_contract.json",
    "default_events_are_projection_only": true,
    "large_data_by_ref": true,
    "detail_fetch_required_for_raw_artifacts": true
  },
  "first_live_slice_exit_criteria": [
    "registry declares infring_native",
    "router can select an engine_id",
    "one engine emits assistant.delta and turn.complete",
    "all emitted events carry trace_id",
    "tool/artifact/receipt data is represented by refs",
    "private adapter contracts declare every selectable engine",
    "no runtime-specific public socket schemas are allowed",
    "Kernel/Core remains engine-neutral while receipts may record engine_id",
    "Codex, Claude Code, and Grok Code can be health-checked through the Gateway runtime router with local discovery metadata",
    "Codex and Grok model catalogs prefer runtime CLI discovery; Claude Code model rows use CLI alias discovery until a direct model-list command/API is exposed"
  ],
  "private_adapter_contracts": "validation/conformance/contracts/agent_runtime_adapter_contracts.json",
  "canonical_public_socket_invariant": {
    "single_gateway_socket_schema": true,
    "runtime_specific_public_schemas_allowed": false,
    "public_events_are_runtime_neutral": true,
    "engine_specific_payloads_private_to_adapter": true,
    "adapter_must_normalize_to_public_events": true,
    "shell_sees_engine_projection_not_private_schema": true,
    "adapter_must_not_own_gateway_policy": true,
    "adapter_must_not_host_shell_facing_socket": true
  },
  "engine_discovery_projection": {
    "defaults_are_probes_not_truth": true,
    "gateway_reports_discovery_source": true,
    "gateway_reports_custom_location_allowed": true,
    "shell_may_not_infer_install_state": true,
    "shell_may_not_probe_user_filesystem_directly": true
  },
  "universal_tools_contract": "validation/conformance/contracts/agent_runtime_universal_tools_contract.json",
  "model_provider_inheritance_policy": {
    "srs_ref": "V13-AGENT-RUNTIME-ENGINE-SOCKET-020",
    "owner": "gateway_agent_runtime_socket",
    "rule": "Framework runtimes may inherit the active InfRing LLM provider/model only through Gateway-owned non-secret projections and adapter-owned credential materialization.",
    "precedence": [
      "framework_native_auth_and_model_config",
      "framework_specific_model_selection_from_llm_menu",
      "inherited_active_infring_provider_model",
      "fail_closed_auth_required_or_config_required"
    ],
    "shell_rules": [
      "Shell may display framework-aware model rows and selected provider/model labels.",
      "Shell must not receive, persist, or transmit raw API keys or secret values.",
      "Shell selection is advisory until Gateway attaches a model_provider_context to the turn."
    ],
    "adapter_rules": [
      "Adapters translate model_provider_context into engine-specific args or environment only when the provider is allowlisted.",
      "Adapters must prefer framework native auth when present, then explicit engine selection, then inherited InfRing provider/model.",
      "Adapters must emit auth_required or config_required instead of guessing credentials."
    ]
  }
}
