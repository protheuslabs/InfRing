{
  "type": "agent_runtime_engine_scorecard_contract",
  "schema_version": 1,
  "version": "2026-06-07",
  "owner": "assurance.validation",
  "status": "enforced",
  "purpose": "Track each selectable runtime engine against the same usefulness and reliability capabilities so InfRing can compare native and external engines without dashboard-owned judgment.",
  "engine_registry": "validation/conformance/contracts/agent_runtime_engine_registry.json",
  "turn_outcome_contract": "validation/conformance/contracts/agent_runtime_turn_outcome_contract.json",
  "script": "tests/tooling/scripts/ci/agent_runtime_engine_scorecard.ts",
  "artifact": "core/local/artifacts/agent_runtime_engine_scorecard_current.json",
  "shell_boundary_rule": {
    "shell_may_render_scorecard_projection": true,
    "shell_may_not_score_or_interpret_engines": true,
    "scorecard_owner": "assurance.validation",
    "runtime_evidence_owner": "gateway.runtime.agent_runtime"
  },
  "secondary_promotion_guidance_contract": {
    "source_artifact": "core/local/artifacts/agent_runtime_secondary_promotion_plan_guard_current.json",
    "row_field": "secondary_promotion_guidance",
    "summary_field": "secondary_promotion_plan",
    "row_required_fields": [
      "current_stage",
      "readiness_status",
      "recommended_next_action",
      "promotion_effect"
    ],
    "promotion_effect_required_fields": [
      "daily_driver_eligible_now",
      "counts_as_golden_pair_equivalent",
      "counts_as_native_intelligence_proof",
      "rule"
    ],
    "guidance_only": true,
    "must_not_affect_score": true,
    "must_not_affect_classification": true,
    "must_not_count_as_daily_driver": true,
    "must_not_count_as_golden_pair_equivalent": true,
    "must_not_count_as_native_intelligence_proof": true,
    "rule": "The scorecard may expose secondary runtime promotion guidance for operators, but it must not convert that guidance into promotion evidence or classification authority."
  },
  "scored_capabilities": [
    "registered",
    "adapter_contract",
    "discovery_metadata",
    "model_catalog_metadata",
    "context_continuity",
    "live_work_completion",
    "approval_pause",
    "turn_steering_contract",
    "durable_receipts",
    "activity_trace",
    "practical_usability_loop",
    "structured_transport",
    "transport_migration",
    "error_projection",
    "real_work_replay"
  ],
  "evidence_inputs": {
    "registry": "validation/conformance/contracts/agent_runtime_engine_registry.json",
    "conformance": "core/local/artifacts/agent_runtime_engine_conformance_guard_current.json",
    "context_continuity": "core/local/artifacts/agent_runtime_context_continuity_eval_current.json",
    "live_work": "core/local/artifacts/agent_runtime_live_work_eval_current.json",
    "structured_transport": "core/local/artifacts/agent_runtime_structured_transport_eval_current.json",
    "native_transport_probe": "core/local/artifacts/agent_runtime_native_transport_probe_current.json",
    "transport_migration": "core/local/artifacts/agent_runtime_transport_migration_pressure_guard_current.json",
    "hard_failure_injection": "core/local/artifacts/agent_runtime_hard_failure_injection_eval_current.json",
    "rendered_permission_steering": "core/local/artifacts/agent_runtime_rendered_permission_steering_contract_guard_current.json",
    "real_work_replay": "core/local/artifacts/agent_runtime_real_work_replay_guard_current.json",
    "secondary_promotion_plan": "core/local/artifacts/agent_runtime_secondary_promotion_plan_guard_current.json"
  },
  "score_policy": {
    "pass": 1,
    "partial_or_not_sampled": 0.5,
    "fail": 0,
    "not_applicable": 1,
    "minimum_practical_engine_score": 0.7,
    "minimum_daily_driver_score": 0.85
  },
  "required_report_fields": [
    "engine_id",
    "display_name",
    "score",
    "classification",
    "live_work_evidence",
    "secondary_promotion_guidance",
    "capabilities",
    "next_actions"
  ],
  "live_work_evidence_fields": [
    "working_directory",
    "observed_working_directory",
    "working_directory_observation_source",
    "classification"
  ]
}
