{
  "type": "agent_runtime_turn_outcome_contract",
  "schema_version": 1,
  "version": "2026-06-04",
  "owner": "assurance.validation",
  "status": "contracted",
  "purpose": "Every external or native agent-runtime turn must end in one explicit user-visible outcome so engines cannot appear to silently die.",
  "public_socket_contract": "validation/conformance/contracts/agent_runtime_socket_contract.json",
  "engine_registry": "validation/conformance/contracts/agent_runtime_engine_registry.json",
  "required_terminal_outcomes": [
    {
      "status": "completed",
      "meaning": "The engine completed the turn and returned displayable assistant output.",
      "required_fields": [
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "status",
        "display_text",
        "receipt_refs",
        "activity_trace"
      ],
      "http_projection_status": 200
    },
    {
      "status": "permission_required",
      "meaning": "The engine reached a gated operation and the turn is paused pending a gatekeeper decision.",
      "required_fields": [
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "status",
        "pending_permission_request",
        "approval_pause",
        "receipt_refs",
        "activity_trace"
      ],
      "http_projection_status": 200
    },
    {
      "status": "failed_with_reason",
      "meaning": "The engine failed, but Gateway returned a bounded human-readable reason and retained trace/evidence refs.",
      "required_fields": [
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "status",
        "error_code",
        "reason",
        "display_text",
        "next_actions",
        "receipt_refs",
        "activity_trace"
      ],
      "http_projection_status": 200
    },
    {
      "status": "timed_out_with_reason",
      "meaning": "The engine exceeded the Gateway turn budget and Gateway returned a bounded timeout reason.",
      "required_fields": [
        "trace_id",
        "engine_id",
        "session_id",
        "turn_id",
        "status",
        "error_code",
        "reason",
        "timeout_ms",
        "display_text",
        "next_actions",
        "receipt_refs",
        "activity_trace"
      ],
      "http_projection_status": 200
    }
  ],
  "forbidden_turn_outcomes": [
    "silent_failure",
    "empty_failed_projection",
    "http_502_for_adapter_timeout",
    "worked_timer_without_final_status",
    "missing_error_code_on_failure",
    "missing_display_text_on_failure"
  ],
  "timeout_budget_rule": {
    "gateway_capability_budget_field": "capability_budget.max_turn_seconds",
    "adapter_must_respect_gateway_budget": true,
    "adapter_may_cap_at_seconds": 300,
    "adapter_may_not_default_below_gateway_declared_budget": true,
    "timeout_must_emit_user_visible_activity": true,
    "timeout_must_set_retryable_true": true
  },
  "approval_pause_resume_rule": {
    "gateway_must_record_pending_request": true,
    "shell_may_only_render_request_and_submit_decision": true,
    "shell_may_not_reconstruct_proposal_arguments": true,
    "decision_route_must_resolve_from_gateway_pending_request": true,
    "decision_must_emit_ack_receipt": true,
    "allowed_gatekeepers_today": [
      "user"
    ],
    "future_gatekeepers_allowed": [
      "system_policy",
      "agent_supervisor",
      "admin_agent"
    ],
    "allowed_decisions": [
      "allow_once",
      "deny",
      "always_allow_tool_call"
    ],
    "resume_strategies": [
      "gateway_apply_approved_effect",
      "grant_then_retry_next_turn"
    ]
  },
  "receipt_first_rule": {
    "gateway_must_emit_turn_receipts": true,
    "receipt_projection_must_be_bounded": true,
    "receipt_refs_required_on_terminal_turn_projection": true,
    "receipt_store_owner": "gateway.runtime.agent_runtime_receipts",
    "receipt_store_path": "local/state/observability/agent_runtime/agent_runtime_receipts.jsonl",
    "required_receipt_kinds": [
      "engine_selection",
      "context_pack"
    ],
    "terminal_receipt_kinds": [
      "final_response",
      "approval_pause",
      "failure_classification"
    ],
    "forbidden_receipt_payloads": [
      "raw_provider_transcript",
      "adapter_process_dump",
      "raw_tool_result",
      "trace_body"
    ]
  },
  "activity_trace_parity_rule": {
    "gateway_must_emit_activity_trace_projection": true,
    "shell_may_render_trace_but_not_interpret_provider_payloads": true,
    "activity_trace_must_be_bounded": true,
    "activity_trace_collapsed_by_default": true,
    "activity_trace_requires_worked_label": true,
    "activity_rows_must_have_user_facing_title": true,
    "raw_provider_events_must_remain_behind_refs": true,
    "status_suffix_sandwich_forbidden": true,
    "required_activity_trace_fields": [
      "type",
      "trace_id",
      "engine_id",
      "session_id",
      "turn_id",
      "collapsed_by_default",
      "collapse_label",
      "worked_ms",
      "row_count",
      "rows",
      "summary_text"
    ]
  },
  "pre_turn_failure_rule": {
    "engine_unavailable_must_project_chat_visible_failure": true,
    "health_failure_must_not_be_empty_toast_only": true,
    "gateway_projection_status": "failed_with_reason",
    "http_projection_status": 200,
    "required_fields": [
      "trace_id",
      "engine_id",
      "session_id",
      "turn_id",
      "status",
      "error_code",
      "reason",
      "display_text",
      "next_actions",
      "receipt_refs",
      "activity_trace"
    ]
  },
  "provider_failure_reason_classes": [
    "provider_quota_or_subscription_unavailable",
    "provider_auth_required",
    "provider_rate_limited",
    "provider_network_unavailable",
    "runtime_not_available",
    "turn_failed",
    "turn_timeout"
  ],
  "hard_failure_injection_requirements": {
    "script": "tests/tooling/scripts/ci/agent_runtime_hard_failure_injection_eval.ts",
    "must_write_artifact": "core/local/artifacts/agent_runtime_hard_failure_injection_eval_current.json",
    "must_project_http_200": true,
    "must_include_display_text": true,
    "must_include_next_actions": true,
    "must_include_receipt_refs": true,
    "must_include_activity_trace": true,
    "must_cover_failure_classes": [
      "provider_auth_required",
      "provider_quota_or_subscription_unavailable",
      "provider_rate_limited",
      "provider_network_unavailable",
      "runtime_not_available",
      "turn_timeout",
      "agent_runtime_payload_budget_exceeded",
      "agent_runtime_transport_failure"
    ]
  },
  "live_smoke_requirements": {
    "script": "tests/tooling/scripts/ci/agent_runtime_cli_live_turn_smoke.ts",
    "engines": [
      "codex_cli",
      "claude_code",
      "grok_code"
    ],
    "must_check_health": true,
    "must_submit_real_turn": true,
    "must_record_turn_outcome": true,
    "must_fail_on_silent_outcome": true,
    "must_write_artifact": "core/local/artifacts/agent_runtime_cli_live_turn_smoke_current.json"
  },
  "live_work_eval_requirements": {
    "script": "tests/tooling/scripts/ci/agent_runtime_live_work_eval.ts",
    "default_engine": "codex_cli",
    "supports_engine_matrix": true,
    "engine_matrix_field": "engine_results",
    "default_engine_matrix": [
      "codex_cli"
    ],
    "must_submit_real_turn": true,
    "must_verify_completed_turn": true,
    "must_verify_activity_trace": true,
    "must_verify_receipt_refs": true,
    "must_verify_approval_pause": true,
    "must_verify_decision_resolves_stored_request": true,
    "must_record_working_directory": true,
    "must_record_observed_working_directory_when_available": true,
    "must_remove_probe_artifact": true,
    "must_write_artifact": "core/local/artifacts/agent_runtime_live_work_eval_current.json"
  }
}
