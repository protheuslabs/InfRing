      "universal_tool_posture": {
        "receives_gateway_grants": true,
        "direct_execution_allowed": false,
        "proposal_shape": "infring_universal_tool_proposal"
      },
      "context_transport_mode": "prompt_text_compat",
      "transport_migration_status": "transitional_bootstrap",
      "transitional_prompt_text_allowed": true,
      "structured_transport_target": "structured_json",
      "prompt_text_compat_retirement_signal": "provider exposes stable structured turn/session API or InfRing ships provider-specific structured bridge",
      "prompt_text_compat_risk": "Prompt preambles and text-parsed proposals can become load-bearing if not guarded."
