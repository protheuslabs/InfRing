{
  "type": "agent_runtime_adapter_contract_registry",
  "schema_version": 1,
  "version": "2026-06-03",
  "owner": "validation.conformance",
  "status": "contracted",
  "srs_refs": [
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-006",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-007",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-008",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-009",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-010",
    "V13-AGENT-RUNTIME-ENGINE-SOCKET-014"
  ],
  "policy_refs": [
    "docs/workspace/SRS.md",
    "docs/workspace/gateway_ingress_egress_policy.md",
    "docs/workspace/nexus_conduit_checkpoint_policy.md",
    "docs/workspace/universal_trace_substrate_policy.md"
  ],
  "engine_registry": "validation/conformance/contracts/agent_runtime_engine_registry.json",
  "public_socket_contract": "validation/conformance/contracts/agent_runtime_socket_contract.json",
  "purpose": "Keep one universal public Agent Runtime Socket under gateway/** while allowing each runtime engine to use private adapter-specific schemas behind the Gateway boundary.",
  "canonical_public_socket_invariant": {
    "single_gateway_socket_schema": true,
    "runtime_specific_public_schemas_allowed": false,
    "public_events_are_runtime_neutral": true,
    "engine_specific_payloads_private_to_adapter": true,
    "adapter_must_normalize_to_public_events": true,
    "shell_sees_engine_projection_not_private_schema": true,
    "gateway_router_path": "gateway/runtime/agent_runtime/agent_runtime_router.ts",
    "adapters_are_translator_only": true
  },
  "kernel_decoupling_invariant": {
    "kernel_core_never_imports_engine_adapters": true,
    "kernel_core_never_selects_engine_id": true,
    "kernel_receipts_may_record_engine_id": true,
    "kernel_receipts_may_not_embed_private_adapter_payloads": true,
    "orchestration_is_native_engine_not_kernel_dependency": true,
    "engine_outputs_are_intents_effects_or_receipt_refs": true,
    "durable_effects_remain_kernel_or_gateway_policy_authorized": true
  },
  "private_adapter_shape": {
    "required_fields": [
      "engine_id",
      "private_contract_kind",
      "adapter_path",
      "transport_binding",
      "status",
      "public_socket_schema_fork_allowed",
      "raw_payload_default_allowed",
      "kernel_direct_access_allowed",
      "shell_direct_access_allowed",
      "canonical_event_mapping_required",
      "health_projection_required",
      "discovery",
      "context_transport_mode",
      "transport_migration_status",
      "transitional_prompt_text_allowed",
      "structured_transport_target"
    ],
    "allowed_private_schema_roles": [
      "process_stdout_parser",
      "local_socket_protocol",
      "http_service_protocol",
      "container_service_protocol",
      "native_orchestration_wrapper",
      "manual_custom_socket_config"
    ],
    "forbidden_private_schema_exports": [
      "public_socket_event_shape",
      "kernel_receipt_body_shape",
      "shell_default_message_row_shape",
      "canonical_memory_record_shape"
    ],
    "allowed_context_transport_modes": [
      "prompt_text_compat",
      "structured_json",
      "native_session_bridge"
    ]
  },
  "adapter_contracts": [
