      "adapter_path": "adapters/runtime/agent_engines/infring_native.ts",
      "engine_runtime_path": "orchestration/**",
      "transport_binding": "internal_gateway_adapter",
      "status": "adapter_seam_ready",
      "public_socket_schema_fork_allowed": false,
      "raw_payload_default_allowed": false,
      "kernel_direct_access_allowed": false,
      "shell_direct_access_allowed": false,
      "adapter_specific_schema_scope": "private_adapter_only",
      "canonical_event_mapping_required": true,
      "health_projection_required": true,
      "download_or_config_projection_required": false,
      "notes": "InfRing Native is the default runtime engine, not a privileged Kernel path. It is selected through Gateway like any other engine.",
      "discovery": {
        "custom_location_allowed": false,
        "authority_order": [
          "internal_native_engine"
        ],
        "install_state_source": "internal_native_engine",
        "notes": "Native orchestration is selected through Gateway; it does not require external path discovery."
      },
      "universal_tool_posture": {
        "receives_gateway_grants": true,
        "direct_execution_allowed": false,
        "proposal_shape": "infring_universal_tool_proposal"
      },
      "context_transport_mode": "native_session_bridge",
      "transport_migration_status": "native_target",
      "transitional_prompt_text_allowed": false,
      "structured_transport_target": "native_session_bridge"
    },
