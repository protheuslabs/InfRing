      "download_or_config_projection_required": true,
      "notes": "Codex CLI adapter may parse CLI/process events privately, but must emit only normalized Agent Runtime Socket events by default.",
      "discovery": {
        "custom_location_allowed": true,
        "override_config_key": "agent_runtimes.codex_cli.command",
        "env_vars": [
          "INFRING_CODEX_CLI_PATH",
          "INFRING_CODEX_CLI_BIN"
        ],
        "path_commands": [
          "codex"
        ],
        "default_paths": [
          "~/.local/bin/codex",
          "/Applications/Codex.app/Contents/Resources/codex",
          "/opt/homebrew/bin/codex",
          "/usr/local/bin/codex",
          "%USERPROFILE%\\.local\\bin\\codex.cmd"
        ],
        "authority_order": [
          "user_override",
          "config_value",
          "environment_variable",
          "path_discovery",
          "default_location_probe",
          "missing_installable"
