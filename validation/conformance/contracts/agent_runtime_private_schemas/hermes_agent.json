{
  "type": "agent_runtime_private_schema_contract",
  "schema_version": 1,
  "version": "2026-06-05",
  "engine_id": "hermes_agent",
  "display_name": "Hermes Agent",
  "owner": "validation.agent_runtime",
  "status": "safe_cli_bridge_schema",
  "public_socket_contract": "validation/conformance/contracts/agent_runtime_socket_contract.json",
  "structured_transport_contract": "validation/conformance/contracts/agent_runtime_structured_transport_contract.json",
  "reference_repo": {
    "path": "references/coding-agent-systems/hermes-agent",
    "remote": "https://github.com/NousResearch/hermes-agent.git",
    "head": "6f6eb871d83415fe2980f3483cc41a435ba22196",
    "shallow": false
  },
  "private_schema_scope": {
    "public_socket_schema_fork_allowed": false,
    "private_framework_payloads_visible_to_shell_by_default": false,
    "kernel_direct_access_allowed": false,
    "shell_direct_access_allowed": false,
    "adapter_role": "Translate Hermes CLI/dashboard/gateway protocol into the canonical Agent Runtime Socket; current live bridge is non-mutating Hermes safe oneshot only."
  },
  "upstream_runtime": {
    "package_name": "hermes-agent",
    "cli_executable": "hermes",
    "documented_install_commands": [
      "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash",
      "iex (irm https://hermes-agent.nousresearch.com/install.ps1)"
    ],
    "documented_start_commands": [
      "hermes",
      "hermes gateway setup",
      "hermes gateway start",
      "hermes dashboard",
      "python -m hermes_cli.main web --no-open"
    ],
    "documented_dashboard_api_port": 9119,
    "default_unix_home": "~/.hermes",
    "default_windows_home": "%LOCALAPPDATA%\\hermes"
  },
  "discovery_schema": {
    "authority_order": [
      "user_override",
      "config_value",
      "environment_variable",
      "path_discovery",
      "default_location_probe",
      "default_url_probe",
      "missing_installable"
    ],
    "config_keys": {
      "url": "agent_runtimes.hermes_agent.url",
      "command": "agent_runtimes.hermes_agent.command",
      "home": "agent_runtimes.hermes_agent.home"
    },
    "env_vars": [
      "INFRING_HERMES_AGENT_URL",
      "HERMES_DASHBOARD_URL",
      "INFRING_HERMES_AGENT_COMMAND",
      "INFRING_HERMES_AGENT_HOME",
      "INFRING_HERMES_AGENT_SAFE_TOOLSETS"
    ],
    "path_commands": [
      "hermes"
    ],
    "default_paths": [
      "~/.local/bin/hermes",
      "~/.hermes/bin/hermes",
      "%LOCALAPPDATA%\\hermes\\bin\\hermes.exe"
    ],
    "default_urls": [
      "http://127.0.0.1:9119"
    ],
    "health_probe_candidates": [
      {
        "method": "GET",
        "path": "/api/status"
      },
      {
        "method": "GET",
        "path": "/api/auth/me",
        "allow_unauthorized": true
      },
      {
        "method": "GET",
        "path": "/api/sessions?limit=1&offset=0"
      },
      {
        "method": "GET",
        "path": "/api/config/schema"
      }
    ],
    "availability_rule": "Hermes becomes selectable only when the safe CLI oneshot bridge is available, or after a future mediated dashboard/session bridge can pause for InfRing approvals. Dashboard URL health alone is projected as health_only.",
    "provider_readiness_probe": {
      "command_shape": "hermes status",
      "auth_required_status": "auth_required",
      "setup_action_ref": "agent_runtime_setup/hermes_agent_provider",
      "selectable_when_auth_required": false,
      "reason": "Hermes can be installed and safe-bridge reachable while still unable to answer because no inference provider/model/API credential is configured."
    },
    "infring_managed_override_paths": [
      "~/.infring/external_runtimes/hermes_agent/venv/bin/hermes",
      "%LOCALAPPDATA%\\InfRing\\external_runtimes\\hermes_agent\\venv\\Scripts\\hermes.exe"
    ],
    "override_note": "Default paths are upstream/user install locations only. InfRing-managed or cloned/runtime-local paths must be selected through user override, config, or environment variable."
  },
  "structured_turn_mapping": {
    "input_contract": "AgentRuntimeStructuredTurn",
    "context_transport_mode": "prompt_text_compat",
    "turn_submission_candidates": [
      {
        "kind": "safe_cli_oneshot_bridge",
        "command_shape": "hermes --toolsets safe -z <bounded InfRing context prompt>",
        "status": "active_safe_non_mutating_bridge",
        "constraints": [
          "uses prompt_text_compat until Hermes exposes a stable structured/native session bridge",
          "forbids terminal/file/debugging/all/full Hermes preset toolsets in this bridge",
          "does not claim mutating work is complete without InfRing Gateway/Kernel receipts"
        ]
      },
      {
        "kind": "dashboard_api_session_bridge",
        "source_hint": "web/src/lib/api.ts exposes /api/sessions and /api/sessions/:id/messages; websocket auth is ticket/token mediated.",
        "status": "future_mediated_bridge_required_for_mutating_tools"
      },
      {
        "kind": "cli_session_bridge",
        "command_shape": "interactive Hermes CLI with approval callback mediation",
        "status": "blocked_until_approval_bridge_bound"
      }
    ],
    "required_normalized_outputs": [
      "activity.started",
      "activity.updated",
      "tool.proposed",
      "permission.requested",
      "artifact.proposed",
      "assistant.output.delta",
      "turn.completed",
      "turn.failed"
    ],
    "forbidden_default_outputs": [
      "external_framework_transcript",
      "raw_tool_result",
      "raw_dashboard_payload",
      "raw_session_token",
      "raw_oauth_cookie"
    ],
    "structured_transport_target": "structured_json",
    "transport_migration_status": "transitional_safe_oneshot_bridge"
  },
  "approval_and_tool_policy": {
    "universal_tool_grants_required": true,
    "engines_may_propose_tool_calls": true,
    "engines_may_not_execute_universal_tools_directly": true,
    "durable_effects_require_gateway_or_kernel_receipts": true,
    "write_outside_infring_workspace_requires_approval": true,
    "private_session_credentials_must_not_leave_adapter": true,
    "hermes_oneshot_auto_bypasses_native_approvals": true,
    "safe_cli_bridge_forbids_file_terminal_toolsets": true,
    "mutating_tool_bridge_status": "blocked_until_mediated_approval_bridge",
    "safe_cli_bridge_default_toolsets": "safe",
    "safe_cli_bridge_forbidden_toolsets": [
      "*",
      "all",
      "terminal",
      "file",
      "debugging",
      "hermes-cli",
      "hermes-acp",
      "hermes-telegram",
      "hermes-discord",
      "hermes-whatsapp",
      "hermes-slack"
    ]
  },
  "payload_budget": {
    "default_event_max_bytes": 65536,
    "raw_private_payload_storage": "evidence_ref_only",
    "shell_projection": "bounded_activity_rows_plus_detail_refs"
  },
  "model_provider_inheritance": {
    "srs_ref": "V13-AGENT-RUNTIME-ENGINE-SOCKET-020",
    "public_socket_secret_policy": "no_api_keys_or_secret_paths_in_public_payloads",
    "adapter_materialization": "private_adapter_may_translate_gateway_model_provider_context_into_env_or_framework_config",
    "allowed_inherited_env": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "XAI_API_KEY",
      "GROK_API_KEY",
      "OPENROUTER_API_KEY",
      "GOOGLE_API_KEY",
      "GEMINI_API_KEY",
      "DEEPSEEK_API_KEY",
      "MISTRAL_API_KEY",
      "COHERE_API_KEY",
      "GROQ_API_KEY",
      "OLLAMA_HOST",
      "LLAMA_CPP_SERVER_URL"
    ],
    "fail_closed": "auth_required_or_config_required_when_no_framework_native_or_inherited_provider_is_available"
  }
}
