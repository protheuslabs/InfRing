    {
      "engine_id": "infring_native",
      "display_name": "InfRing Native",
      "engine_kind": "native_orchestration",
      "implementation_path": "orchestration/**",
      "transport_kind": "internal_gateway_adapter",
      "status": "adapter_seam_ready",
      "capabilities": [
        "planning",
        "workflow_execution",
        "tool_sequencing",
        "task_decomposition",
        "repair_loop",
        "multi_agent_coordination",
        "receipt_emission"
      ],
      "health_contract": "orchestration health projected through Gateway",
      "adapter_boundary": "Gateway runtime router calls native orchestration through a normalized engine wrapper; Shell never calls orchestration directly.",
      "authority_constraints": [
        "kernel_authority_constant",
        "gateway_policy_required",
        "trace_id_required",
        "receipt_ref_required_for_durable_effects"
      ],
      "install": {
        "install_state_source": "internal_native_engine",
        "download_available": false,
        "download_action_ref": null,
        "display_badge": "native"
      },
      "discovery": {
        "custom_location_allowed": false,
        "authority_order": [
          "internal_native_engine"
        ],
        "install_state_source": "internal_native_engine",
        "notes": "Native orchestration is selected through Gateway; it does not require external path discovery."
      },
      "context_transport_mode": "native_session_bridge",
      "structured_transport_target": "native_session_bridge",
      "transport_migration_status": "native_target"
    },
    {
      "engine_id": "codex_cli",
      "display_name": "Codex CLI",
      "engine_kind": "external_cli_adapter",
      "implementation_path": "adapters/runtime/agent_engines/codex_cli/**",
      "transport_kind": "local_process_or_socket",
      "status": "adapter_seam_ready",
      "capabilities": [
        "coding_agent_loop",
        "workspace_read",
        "workspace_edit_proposal",
        "command_proposal",
        "artifact_collection"
      ],
      "health_contract": "adapter resolves command availability and startup readiness without leaking process internals",
      "adapter_boundary": "Gateway launches or connects to the adapter and normalizes stdout/socket events into the agent runtime event stream.",
      "authority_constraints": [
        "no_direct_kernel_write",
        "no_direct_shell_socket",
        "workspace_scope_required",
        "mutation_approval_required"
      ],
      "install": {
        "install_state_source": "adapter_health_check",
        "download_available": true,
        "download_action_ref": "agent_runtime_download/codex_cli",
        "preferred_install_method": "command_line",
        "command_line_hint": "Install the Codex CLI using the current official OpenAI/Codex installer for this machine.",
        "browser_fallback_url": "https://developers.openai.com/codex",
        "display_when_missing": "download_icon",
        "command_line_install": {
          "permission_mode": "allowed",
          "commands": [
            {
              "platforms": [
                "darwin",
                "linux",
                "win32"
              ],
              "command": "npm",
              "args": [
                "install",
                "-g",
                "@openai/codex"
              ],
              "timeout_ms": 240000
            }
          ]
        }
      },
      "discovery": {
        "custom_location_allowed": true,
        "override_config_key": "agent_runtimes.codex_cli.command",
        "env_vars": [
          "INFRING_CODEX_CLI_PATH",
          "INFRING_CODEX_CLI_BIN"
        ],
        "path_commands": [
          "codex"
        ],
        "default_paths": [
          "~/.local/bin/codex",
          "/Applications/Codex.app/Contents/Resources/codex",
          "/opt/homebrew/bin/codex",
          "/usr/local/bin/codex",
          "%USERPROFILE%\\.local\\bin\\codex.cmd"
        ],
        "authority_order": [
          "user_override",
          "config_value",
          "environment_variable",
          "path_discovery",
          "default_location_probe",
          "missing_installable"
        ]
      },
      "context_transport_mode": "prompt_text_compat",
      "structured_transport_target": "structured_json",
      "transport_migration_status": "transitional_bootstrap"
    },
