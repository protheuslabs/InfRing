    "legacy_alias": "model_menu",
    "source_values": [
      "framework_native",
      "inherited_infring",
      "system_default"
    ],
    "secrets_included": false,
    "rule": "Shell and CLI clients consume available_models. Registry model_menu entries are config/compat input and must not become a Shell-owned model authority.",
    "default_selection_policy": {
      "default_is_model": false,
      "rule": "Default may describe how an engine selects a model when no model is provided, but default must not appear as an available model row."
    },
    "catalog_refresh_policy": {
      "static_seed_is_not_freshness_authority": true,
      "rule": "available_models may use registry rows as a seed, but provider/framework discovery should replace seed rows when a trusted model listing source is available."
    }
  },
  "required_engine_interface": [
    "health_check",
    "start_session",
    "submit_turn",
    "stream_events",
    "cancel_turn",
    "collect_artifacts",
    "emit_receipts"
  ],
  "authority_rules": {
    "kernel_authority_constant": true,
    "gateway_boundary_constant": true,
    "engines_are_work_runtimes_not_truth_owners": true,
