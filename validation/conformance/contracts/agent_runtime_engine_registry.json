  "first_adapter_recommendation": {
    "engine_id": "codex_cli",
    "reason": "Codex CLI remains the smallest useful external-engine slice; Claude Code and Grok Code now share the same bounded CLI adapter discovery path for local availability checks."
  },
  "private_adapter_contracts": "validation/conformance/contracts/agent_runtime_adapter_contracts.json",
  "engine_selection_model": {
    "public_selection_surface": "Gateway Agent Runtime Socket engine_id",
    "default_native_engine": "infring_native",
    "native_engine_runtime_path": "orchestration/**",
    "engine_selection_owner": "gateway.agent_runtime_router",
    "shell_selection_role": "display bounded engine projections and submit selected engine_id through Gateway only",
    "kernel_selection_role": "none; Kernel executes authorized effects and records receipts without selecting runtime engines",
    "private_adapter_role": "translate engine-specific protocols into canonical socket events behind Gateway"
  },
  "discovery_model": {
    "defaults_are_probes_not_truth": true,
    "discovery_owner": "gateway.agent_runtime_router",
    "projection_owner": "gateway.agent_runtime_router",
    "shell_role": "display adapter health/install/config projections and submit selected engine_id only",
    "config_location": "~/.infring/agent_runtimes.json",
    "custom_location_allowed": true,
    "authority_order": [
      "user_override",
      "config_value",
      "environment_variable",
      "path_discovery",
      "default_location_probe",
      "default_url_probe",
      "missing_installable"
    ]
  },
  "universal_tools_contract": "validation/conformance/contracts/agent_runtime_universal_tools_contract.json",
  "universal_tools_selection_rule": "All selectable engines receive the same Gateway-owned universal core-tool grant shape; engines propose calls, Gateway validates, Kernel/Memory/Artifact authority executes durable effects.",
  "structured_transport_contract": "validation/conformance/contracts/agent_runtime_structured_transport_contract.json",
  "transport_selection_rule": {
    "public_socket_schema": "single_gateway_socket_schema",
    "adapter_transport_modes": [
      "prompt_text_compat",
      "structured_json",
      "native_session_bridge"
    ],
    "preferred_external_mode": "structured_json",
    "prompt_text_compat_is_transitional": true,
    "kernel_selection_role": "none; Kernel executes authorized effects and records receipts without selecting runtime engines"
  }
