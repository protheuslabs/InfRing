      "id": "post_tool_framework_comparison",
      "category": "post_tool_synthesis",
      "tags": ["comparison", "software_technical", "current"],
      "prompt": "Compare LlamaIndex workflows versus LangGraph for document-heavy research assistants.",
      "expected_gate_path": {
        "gate_1": "tool_required_or_pending_tool_result",
