        "gate_3": "batch_query",
        "gate_4_required_fields": ["source", "query", "aperture"],
        "post_tool": "must_synthesize_from_evidence_refs"
      },
      "required_entities": ["LlamaIndex", "LangGraph"],
      "required_facets": ["document ingestion", "stateful orchestration"]
